{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "eSIM compatible devices",
  "type": "object",
  "required": ["updatedAt", "brands"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "updatedAt": {
      "description": "Date of the last data review (YYYY-MM-DD)",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "notes", "devices"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "notes": {
            "description": "Caveats that apply to the whole brand (regional variants, unlock requirements)",
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "devices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["model", "type"],
              "additionalProperties": false,
              "properties": {
                "model": { "type": "string", "minLength": 1 },
                "type": { "enum": ["phone", "tablet"] },
                "aliases": {
                  "description": "Other names the device is sold or searched under",
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
